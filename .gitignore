# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Python / build outputs
__pycache__/
*.pyc
.venv/
build/
*.blend1

# Textures Godot extracts from the GLBs on import (regenerated automatically)
godot/assets/**/*.jpg
godot/assets/**/*.jpg.import
godot/assets/**/*.png
godot/assets/**/*.png.import
